# Postgres connection string for the LangGraph checkpointer.
# Leave unset in local dev to fall back to the in-memory checkpointer (MemorySaver).
DATABASE_URL=

# When set to 1, agent-runtime never spawns a real `opencode` process; it returns
# deterministic stub AgentResults (or fixtures) instead. Use this to avoid burning
# LLM rate limits during development.
AGENT_DRY_RUN=1

# LangSmith tracing (M6 only). Never commit a real API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-agentic-workflow-poc

# Maximum number of workflow runs the agent-service will execute concurrently.
MAX_CONCURRENT_RUNS=4
